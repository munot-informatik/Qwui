{
  "name": "qwui-desktop",
  "productName": "Qwui",
  "version": "1.1.0",
  "description": "Qwui Windows-Desktop-Version (Electron, lokale SQLite-Datenbank)",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/copy-shared.js",
    "start": "electron .",
    "predev": "node scripts/copy-shared.js",
    "dev": "cross-env QWUI_DEV_SERVER_URL=http://localhost:5173 electron .",
    "predist": "node scripts/copy-shared.js && node scripts/copy-dist.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "smtp-server": "^3.20.2"
  },
  "build": {
    "appId": "ch.munot-informatik.qwui",
    "productName": "Qwui",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "dataDir.js",
      "companyStore.js",
      "excelStore.js",
      "sqliteStore.js",
      "migrateExcel.js",
      "secrets.js",
      "mailer.js",
      "backupCrypto.js",
      "autoBackup.js",
      "shopSync.js",
      "shared/**/*",
      "logoCache.js",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Qwui-${version}.exe"
    }
  }
}
